{
  "name": "pramochak-mc-launcher",
  "version": "1.0.0",
  "description": "The fastest, lightweight, next-generation Minecraft Studio Launcher built with Tauri v2, Rust & Electron by Maheshwar Hari Tripathi",
  "author": "Maheshwar Hari Tripathi (https://github.com/maheshwarkibehan-hub)",
  "homepage": "https://github.com/maheshwarkibehan-hub/pramochak-mc-launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/maheshwarkibehan-hub/pramochak-mc-launcher.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "tauri:dev": "npm --prefix tauri-launcher run tauri dev",
    "tauri:build": "npm --prefix tauri-launcher run tauri build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "minecraft",
    "minecraft-launcher",
    "tauri",
    "rust",
    "electron",
    "fabric",
    "forge",
    "quilt",
    "minecraft-modpack",
    "modrinth",
    "curseforge",
    "minecraft-skins",
    "webgl",
    "game-launcher",
    "desktop-app",
    "gaming",
    "minecraft-client"
  ],
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "minecraft-launcher-core": "^3.18.2"
  },
  "build": {
    "appId": "com.pramochak.mclauncher",
    "productName": "Pramochak MC Launcher",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "applogo.ico"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*"
    ]
  }
}
